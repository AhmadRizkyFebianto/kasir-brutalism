# Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_POS_STORE_ID=

# Server only; bypasses RLS. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Database connection string for direct SQL migrations only; the Next.js app does not use it at runtime.
SUPABASE_DB_URL=

# Midtrans server credentials (feature slice: payments)
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_NOTIFICATION_URL=
MIDTRANS_ENABLED_PAYMENTS=qris
NEXT_PUBLIC_APP_URL=http://localhost:3000
